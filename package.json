{
  "name": "myfingap",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A small, deterministic financial blind-spot assessment with Telegram and terminal adapters.",
  "engines": {
    "node": ">=24.0.0 <25",
    "npm": ">=11.6.0 <12"
  },
  "scripts": {
    "dev": "tsx src/cli.ts",
    "demo": "tsx src/demo.ts",
    "telegram": "tsx src/telegram.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/cli.js",
    "start:telegram": "node dist/telegram.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "npm run lint && npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "@mastra/core": "1.66.0",
    "dotenv": "17.2.2",
    "grammy": "1.38.2",
    "openai": "7.15.0",
    "zod": "4.1.12"
  },
  "devDependencies": {
    "@eslint/js": "9.35.0",
    "@types/node": "24.3.1",
    "eslint": "9.35.0",
    "tsx": "4.20.5",
    "typescript": "5.9.3",
    "typescript-eslint": "8.43.0",
    "vitest": "4.1.11"
  },
  "packageManager": "npm@11.6.0"
}
