{
  "name": "finblindspot",
  "version": "0.1.0",
  "private": true,
  "description": "Financial Blindspot Detector - education-only Telegram assessment for internationally mobile professionals",
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "LOG_LEVEL=${LOG_LEVEL:-debug} tsx watch src/index.ts",
    "start": "node dist/index.js",
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@mastra/core": "1.66.0",
    "@mastra/libsql": "1.22.5",
    "@mastra/memory": "1.29.0",
    "better-sqlite3": "13.0.3",
    "dotenv": "17.4.2",
    "grammy": "1.46.0",
    "openai": "7.15.0",
    "pdfkit": "0.20.2",
    "zod": "4.6.2"
  },
  "devDependencies": {
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "24.10.1",
    "@types/pdfkit": "0.17.6",
    "tsx": "4.23.13",
    "typescript": "5.9.3",
    "vitest": "5.0.0"
  }
}
