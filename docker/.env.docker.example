# Environment Variables for Docker Agent Sandbox
# Copy this file to .env or .env.docker and populate with your credentials

# Model Provider Keys
ANTHROPIC_API_KEY=
NEBIUS_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=

# Hackathon / Integration Keys
TELEGRAM_BOT_TOKEN=
GALTEA_API_KEY=

# Host UID/GID for permission mapping (defaults to current user if unset)
HOST_UID=1000
HOST_GID=1000
