# All optional for the terminal demo. No credentials are required for npm run demo.
MYFINGAP_DB=data/myfingap.db

# Obtain a bot token from https://t.me/BotFather; private chats only.
TELEGRAM_BOT_TOKEN=

# Set all three to enable natural-language extraction and the outbound classifier.
# Choose model IDs available to your Nebius account.
NEBIUS_API_KEY=
NEBIUS_INTERVIEW_MODEL=
NEBIUS_GUARDRAIL_MODEL=
