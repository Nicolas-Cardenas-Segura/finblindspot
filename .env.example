# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=
# Nebius Token Factory (OpenAI-compatible)
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/
NEBIUS_INTERVIEW_MODEL=deepseek-ai/DeepSeek-V4.1-Flash
NEBIUS_GUARDRAIL_MODEL=nvidia/Nemotron-3_5-Lightning
# Optional: Galtea adversarial evaluation
GALTEA_API_KEY=
GALTEA_VERSION_ID=
GALTEA_OTEL_ENDPOINT=https://otel.platform.prod-main.galtea.ai:4318/otel/traces
# SQLite database file (parent directory is created on boot)
DATABASE_PATH=./data/finblindspot.sqlite
# Nudge scheduler: how often to check for due reminders (seconds)
NUDGE_TICK_SECONDS=3600
# Demo fast-forward: when set, "6 months" becomes 6 * N minutes (empty = real months)
NUDGE_DEMO_MINUTES=
# Seconds of silence before Sam offers to stop and build a report from what was given (default 120)
IDLE_PROPOSE_STOP_SECONDS=120
# Log verbosity: debug | info | warn | error | silent (default info; `npm run dev` forces debug)
# debug prints every user message, model prompt/response and state transition - local use only
LOG_LEVEL=
