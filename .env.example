# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=
# Nebius Token Factory (OpenAI-compatible)
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/
# Optional: Galtea adversarial evaluation
GALTEA_API_KEY=
# SQLite database file (parent directory is created on boot)
DATABASE_PATH=./data/finblindspot.sqlite
# Nudge scheduler: how often to check for due reminders (seconds)
NUDGE_TICK_SECONDS=3600
# Demo fast-forward: when set, "6 months" becomes 6 * N minutes (empty = real months)
NUDGE_DEMO_MINUTES=
